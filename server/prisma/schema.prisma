// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTENTICACIÓN
// ==========================================

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  role        UserRole     @default(OWNER)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  restaurants Restaurant[]
}

enum UserRole {
  SUPER_ADMIN
  OWNER
}

model Restaurant {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  name            String
  email           String   @unique
  password        String
  phone           String?
  address         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cedulaJuridica  String?
  tipoCambioDolar Decimal  @default(0) @db.Decimal(10, 2)

  categorias    Categoria[]
  productos     Producto[]
  secciones     Seccion[]
  mesas         Mesa[]
  ordenes       Orden[]
  facturas      Factura[]
  cierres       Cierre[]
  itemsAnulados ItemAnulado[]
}

// ==========================================
// MENÚ
// ==========================================

model Categoria {
  id           Int        @id @default(autoincrement())
  nombre       String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  productos    Producto[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Producto {
  id            Int           @id @default(autoincrement())
  nombre        String
  precio        Decimal       @db.Decimal(10, 2)
  categoriaId   Int
  categoria     Categoria     @relation(fields: [categoriaId], references: [id])
  restaurantId  Int
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activo        Boolean       @default(true)
  ordenItems    OrdenItem[]
  facturaItems  FacturaItem[]
  itemsAnulados ItemAnulado[]
}

// ==========================================
// SECCIONES (reglas de negocio configurables por el propio restaurante)
// ==========================================

model Seccion {
  id                 Int        @id @default(autoincrement())
  nombre             String // "Salón", "Para Llevar", "Uber"
  aplicaServicio     Boolean    @default(false)
  porcentajeServicio Decimal    @default(0) @db.Decimal(5, 2)
  aplicaComision     Boolean    @default(false)
  porcentajeComision Decimal    @default(0) @db.Decimal(5, 2)
  restaurantId       Int
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  mesas              Mesa[]
  facturas           Factura[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

// ==========================================
// MESAS
// ==========================================

model Mesa {
  id           Int        @id @default(autoincrement())
  nombre       String
  seccionId    Int
  seccion      Seccion    @relation(fields: [seccionId], references: [id])
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  ordenes      Orden[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// ORDEN (carrito temporal por mesa, se borra al facturar)
// ==========================================

model Orden {
  id           Int         @id @default(autoincrement())
  mesaId       Int         @unique
  mesa         Mesa        @relation(fields: [mesaId], references: [id])
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  items        OrdenItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrdenItem {
  id             Int      @id @default(autoincrement())
  ordenId        Int
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([ordenId, productoId])
}

model ItemAnulado {
  id             Int        @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  nombreMesa     String
  productoId     Int
  producto       Producto   @relation(fields: [productoId], references: [id])
  nombreProducto String
  cantidad       Int
  precioUnitario Decimal    @db.Decimal(10, 2)
  fecha          DateTime   @default(now())
}

// ==========================================
// FACTURA (registro permanente, base de los reportes)
// ==========================================

model Factura {
  id            Int           @id @default(autoincrement())
  numeroFactura Int
  nombreMesa    String // snapshot, ej. "Mesa 5" — solo para mostrar en el recibo
  seccionId     Int
  seccion       Seccion       @relation(fields: [seccionId], references: [id])
  restaurantId  Int
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  items         FacturaItem[]
  subtotal      Decimal       @db.Decimal(10, 2)
  montoServicio Decimal       @default(0) @db.Decimal(10, 2)
  montoComision Decimal       @default(0) @db.Decimal(10, 2)
  montoNeto     Decimal       @db.Decimal(10, 2)
  total  Decimal  @db.Decimal(10, 2)  @default(0)
  fecha         DateTime      @default(now())
  createdAt     DateTime      @default(now())
  anulada       Boolean       @default(false)

  @@unique([restaurantId, numeroFactura])
}

model FacturaItem {
  id             Int      @id @default(autoincrement())
  facturaId      Int
  factura        Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  nombreProducto String // snapshot: no cambia aunque el producto se edite/borre después
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
}

// ==========================================
// CIERRE (bloqueo diario + resumen de facturación)
// ==========================================

model Cierre {
  id             Int        @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  fecha          DateTime   @db.Date
  primeraFactura Int // numeroFactura más bajo del día
  ultimaFactura  Int // numeroFactura más alto del día
  totalNeto      Decimal    @db.Decimal(10, 2)
  totalServicio  Decimal    @db.Decimal(10, 2)
  ingresoReal    Decimal    @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, fecha])
}
